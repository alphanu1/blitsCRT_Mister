# Kernel options for the blitsCRT_Mister boot proof-of-concept, merged on top of
# the base defconfig alongside blitscrt_gadget.config.
#
# These let our own kernel carry an embedded initramfs, populate /dev on its own,
# talk to the SD card, mount the FAT partition, and print to the HPS UART -- the
# minimum to boot to init and write the boot log to /media/fat.
#
# On MiSTer's defconfig most of these are already set (it boots from SD and FAT);
# listing them makes a fresh or mainline socfpga base work too. merge_config is
# idempotent, so re-stating an already-set option is harmless.

# --- Embedded initramfs ---
# The actual source path is set by the build (make points INITRAMFS_SOURCE at the
# staged rootfs); only the enabling switch belongs in the fragment.
CONFIG_BLK_DEV_INITRD=y

# --- /dev without a static device table ---
# So init can find /dev/mmcblk* and the console without mknod in the archive.
CONFIG_DEVTMPFS=y

# --- /dev/mem, open ---
# blitscrtd reaches the fabric by mmap-ing the HPS gp and reset-manager registers
# through /dev/mem, so the device must exist and must not be range-restricted.
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set

# --- SD / eMMC (DesignWare controller on the Cyclone V HPS) ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y

# --- FAT / exFAT, so /media/fat mounts ---
# MiSTer formats cards over 32 GB as exFAT (and smaller ones as FAT32), so build
# both. Codepage 437 + iso8859-1 are what a FAT MiSTer card is formatted with.
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# --- Serial console on the HPS UART (back-panel micro-B) ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
