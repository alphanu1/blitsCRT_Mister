# Kernel options blitsCRT_Mister needs, beyond a stock MiSTer/DE10 config.
#
# The device is a USB gadget presenting the GUD protocol over FunctionFS, so
# the controller must run in peripheral mode and FunctionFS must be available.
# The MiSTer kernel already carries dwc2; the FunctionFS options are what tend
# to be missing.

# --- USB device controller in peripheral or OTG mode ---
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y

# --- FunctionFS, the transport blitscrtd uses ---
#
# USB_CONFIGFS_F_FS is the one that matters: it selects USB_F_FS, the FunctionFS
# *function* that a configfs-composed gadget uses.
#
# CONFIG_USB_FUNCTIONFS is a different thing despite the name -- the legacy
# precomposed g_ffs gadget from drivers/usb/gadget/legacy/. Built in, it
# registers a FunctionFS device of its own at boot and claims the instance, so
# creating functions/ffs.blitscrt through configfs fails with EBUSY on a fresh
# boot with nothing else running. It took a while to place, because the error
# points at the thing being created rather than the thing holding it. Leave it
# off; configfs does not need it.
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
# CONFIG_USB_FUNCTIONFS is not set

# --- GUD is driverless on the host; nothing extra is needed on the device ---
# The host side (a PC) needs CONFIG_DRM_GUD, in-tree since 5.13. That is a host
# option, not a device one, and is listed here only as a reminder.
# CONFIG_DRM_GUD=m   # host only
